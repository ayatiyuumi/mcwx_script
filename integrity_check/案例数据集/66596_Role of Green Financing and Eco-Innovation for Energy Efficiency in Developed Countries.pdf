<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.3-c011 66.145661, 2012/02/06-14:56:27        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>olive, self-compatibility, in vitro embryo culture, endosperm, SSRs analysis</pdf:Keywords>
         <pdf:Producer>pdfTeX-1.40.15</pdf:Producer>
         <pdf:PDFVersion>1.5</pdf:PDFVersion>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/postscript</dc:format>
         <dc:source>fpls-10-00451.tex</dc:source>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Self-Incompatibility Assessment of Some Italian Olive Genotypes (Olea europaea L.) and Cross-Derived Seedling Selection by SSR Markers on Seed Endosperms</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The morphology of olive flowers allows either self- or cross-pollination that could partially explain the existence of both reproductive features in this species.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Wilma Sabetta</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:date>
            <rdf:Seq>
               <rdf:li>2019-04-10T20:03:24+05:30</rdf:li>
            </rdf:Seq>
         </dc:date>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>olive</rdf:li>
               <rdf:li>self-compatibility</rdf:li>
               <rdf:li>in vitro embryo culture</rdf:li>
               <rdf:li>endosperm</rdf:li>
               <rdf:li>SSRs analysis</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
